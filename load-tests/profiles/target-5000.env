# The 5,000-user target (CLAUDE.md: k6 load tests run at the end of each phase against it). Run on proper hardware:
# a separate load generator machine, a dedicated stack (not a laptop AppHost), and Keycloak's rate limits checked.
# Usage (POSIX shell): set -a; . profiles/target-5000.env; set +a
# Setup: 100 organizations x 49 members = 4,900 users + 100 owners ~ 5,000 (an owner invites at most 50 a day).
export ORGS=100
export MEMBERS=49
export CHANNELS=5
export SEED_MESSAGES=120
export CONCURRENCY=16
# Messaging: every user online holds a live connection; about one message per user every two minutes.
export LISTENERS=5000
export SEND_RATE=40
export READ_RATE=60
export DURATION=15m
# Reconnect storm: a fifth of the users come back within seconds.
export STORM_RATE=300
export STORM_PEAK=60s

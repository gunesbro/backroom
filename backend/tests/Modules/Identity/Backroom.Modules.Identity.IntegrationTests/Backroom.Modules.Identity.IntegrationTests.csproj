  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Modules\CellManagement\Backroom.Modules.CellManagement.Infrastructure\Backroom.Modules.CellManagement.Infrastructure.csproj" />

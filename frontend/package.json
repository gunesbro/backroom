{
  "name": "@backroom/frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"!@backroom/desktop\" build",
    "check:bundle": "node tooling/check-bundle-size.js",
    "update:emoji-fixture": "node tooling/update-emoji-fixture.js",
    "update:emoji-flags": "node tooling/update-emoji-flags.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @backroom/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:dev": "pnpm --filter @backroom/desktop dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}

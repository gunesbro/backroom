{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Backroom",
  "version": "0.0.0",
  "identifier": "io.github.gunesbro.backroom",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "pnpm --filter @backroom/web dev",
    "beforeBuildCommand": "pnpm --filter @backroom/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Backroom",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; require-trusted-types-for 'script'; trusted-types lexical 'allow-duplicates'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["backroom"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

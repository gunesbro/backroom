{
  "realm": "backroom",
  "displayName": "Backroom",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "ssoSessionIdleTimeoutRememberMe": 2592000,
  "ssoSessionMaxLifespanRememberMe": 7776000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "loginTheme": "backroom",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "tr",
    "en"
  ],
  "defaultLocale": "en",
  "smtpServer": {
    "host": "${BACKROOM_SMTP_HOST}",
    "port": "${BACKROOM_SMTP_PORT}",
    "from": "no-reply@backroom.test",
    "fromDisplayName": "Backroom (development)",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "ops",
        "description": "Operations panel. The panel also requires two-factor authentication (amr contains otp)."
      },
      {
        "name": "offline_access",
        "description": "Built-in role for offline tokens; assigned to no one, so no token outlives its session."
      },
      {
        "name": "uma_authorization",
        "description": "Built-in role; assigned to no one."
      },
      {
        "name": "default-roles-backroom",
        "description": "Roles every new user gets: none."
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-backroom"
  },
  "clients": [
    {
      "clientId": "web",
      "name": "Backroom web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*",
        "backchannel.logout.url": "${BACKROOM_BACKCHANNEL_LOGOUT_URL}",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "optionalClientScopes": [
        "control-plane"
      ],
      "defaultClientScopes": [
        "basic",
        "acr",
        "web-origins",
        "profile",
        "email",
        "roles"
      ]
    },
    {
      "clientId": "desktop",
      "name": "Backroom desktop",
      "description": "Signs in through the system browser with a loopback redirect (RFC 8252); Keycloak accepts any port on 127.0.0.1. Tokens are requested by the app, not a web page, so there are no web origins.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://127.0.0.1/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "false",
        "exclude.issuer.from.auth.response": "false",
        "backchannel.logout.url": "${BACKROOM_BACKCHANNEL_LOGOUT_URL}",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "optionalClientScopes": [
        "control-plane"
      ],
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile",
        "email",
        "roles"
      ]
    },
    {
      "clientId": "ops",
      "name": "Backroom operations panel",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://localhost:5174/*"
      ],
      "webOrigins": [
        "http://localhost:5174"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5174/*",
        "backchannel.logout.url": "${BACKROOM_BACKCHANNEL_LOGOUT_URL}",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "protocolMappers": [
        {
          "name": "authentication methods",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "optionalClientScopes": [
        "control-plane"
      ],
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "acr",
        "web-origins",
        "profile",
        "email",
        "roles"
      ]
    },
    {
      "clientId": "control-plane-admin",
      "name": "Backroom control plane (manages cell clients)",
      "description": "Creates and updates the Keycloak clients and scopes of registered cells. Client credentials only; its service account holds only realm-management/manage-clients.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${BACKROOM_CONTROL_PLANE_ADMIN_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic",
        "roles"
      ]
    }
  ],
  "users": [
    {
      "username": "alice@example.test",

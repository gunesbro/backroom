<Project Sdk="Microsoft.NET.Sdk">

  <!-- Technical module (no Domain, Contracts or Presentation yet): the provider interface, the delivery flow and the templates. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\Backroom.BuildingBlocks.Application\Backroom.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\Organization\Backroom.Modules.Organization.Contracts\Backroom.Modules.Organization.Contracts.csproj" />
  </ItemGroup>

  <!-- Template texts, one file per language (no culture suffix, so MSBuild builds no satellite assembly). -->
  <ItemGroup>
    <EmbeddedResource Include="Templates\*.json" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Backroom.Modules.Email.Infrastructure" />
    <InternalsVisibleTo Include="Backroom.Modules.Email.IntegrationTests" />
  </ItemGroup>

</Project>
